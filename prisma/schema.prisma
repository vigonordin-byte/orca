// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  agents Agent[]
  tasks  Task[]
}

model Provider {
  id       String @id @default(cuid())
  name     String @unique
  authType String

  agents Agent[]
}

enum AgentStatus {
  idle
  working
  error
}

model Agent {
  id         String      @id @default(cuid())
  orgId      String
  providerId String
  name       String
  role       String?
  status     AgentStatus @default(idle)
  createdAt  DateTime    @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  provider     Provider     @relation(fields: [providerId], references: [id])
  tasks        Task[]
}

model Task {
  id          String   @id @default(cuid())
  orgId       String
  agentId     String
  instruction String
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  agent        Agent        @relation(fields: [agentId], references: [id])
  runs         Run[]
}

enum RunStatus {
  working
  done
  error
}

model Run {
  id         String    @id @default(cuid())
  taskId     String
  status     RunStatus @default(working)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     String?
  error      String?

  task   Task    @relation(fields: [taskId], references: [id])
  events Event[]
}

model Event {
  id        String   @id @default(cuid())
  runId     String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id])
}
